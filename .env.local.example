# Copy this file to .env.local and fill in your values

# Required: Postgres connection string (Supabase or otherwise)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Required: 32+ char random secret used to sign session JWTs (src/utils/session.ts)
SESSION_SECRET=change-me-to-a-random-32-plus-char-secret

# Optional: Nayax vending API. When unset, the app uses a built-in fixture provider instead of calling Nayax.
NAYAX_API_URL=https://api.nayax.example.com
NAYAX_API_KEY=your-nayax-api-key
NAYAX_ACTOR_ID=your-nayax-actor-id

# Required only if you expose the sync endpoint: bearer token for POST /api/nayax/sync
NAYAX_SYNC_SECRET=change-me-to-a-random-secret
